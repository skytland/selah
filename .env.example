# YouVersion Bible API
# Register at https://platform.youversion.com to get your App Key
EXPO_PUBLIC_YVP_APP_KEY=your_youversion_app_key_here

# Gloo AI Completions V2 — OAuth2 Client Credentials
# Get credentials at https://studio.ai.gloo.com
EXPO_PUBLIC_GLOO_CLIENT_ID=your_gloo_client_id_here
EXPO_PUBLIC_GLOO_CLIENT_SECRET=your_gloo_client_secret_here

# Solana Network Configuration
# Use devnet for testing, mainnet-beta for production
EXPO_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
EXPO_PUBLIC_SOLANA_NETWORK=devnet

# SELAH SPL Token Mint Address
# Deploy the mint first: npx ts-node scripts/deploy-mint.ts
# Then paste the resulting mint address here
EXPO_PUBLIC_SELAH_MINT_ADDRESS=your_selah_mint_address_here

# Mint Authority Keypair (byte array JSON)
# This keypair controls SELAH minting — keep it secret, never commit .env.local
# Generate with: npx ts-node scripts/generate-keypair.ts
SELAH_MINT_KEYPAIR=[0,0,0,0,...]
